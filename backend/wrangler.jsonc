{
  "name": "tezenas-immersions-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MUTATION_GATE",
        "class_name": "MutationGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v080",
      "new_sqlite_classes": [
        "MutationGate"
      ]
    }
  ]
}
